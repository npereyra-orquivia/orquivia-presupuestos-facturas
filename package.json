{
  "name": "orquivia-presupuestos",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js supabase/tests/backend.test.js",
    "build:production": "node scripts/assert-production-config.mjs && vite build && node scripts/check-public-build.mjs",
    "build:staging": "node scripts/staging-config.mjs && vite build --mode staging && node scripts/check-public-build.mjs",
    "test:database": "node scripts/verify-postgres.mjs",
    "monitor": "node scripts/operations/monitor.mjs",
    "backup": "node scripts/backup/cli.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "imapflow": "2.4.3",
    "nodemailer": "10.2.1",
    "vite": "^7.0.0"
  }
}
